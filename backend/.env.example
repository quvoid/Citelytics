# Supabase project settings — Project Settings > API in the Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey — free Gemini API key
GEMINI_API_KEY=
# Optional override; check https://ai.google.dev/gemini-api/docs/models for current Flash-tier models
GEMINI_MODEL=gemini-2.5-flash

# https://openrouter.ai/keys — free to create, no card required
OPENROUTER_API_KEY=
# Two options:
#  - Genuinely free (default below): a :free model, e.g. openai/gpt-oss-20b:free
#    — costs nothing, but is NOT the model ChatGPT actually runs, so its
#    answers don't really represent "what would ChatGPT say."
#  - Representative of real ChatGPT: openai/gpt-4o-mini — small real
#    per-token cost, but actually approximates ChatGPT's behavior. Check
#    https://openrouter.ai/models?order=pricing-low-to-high for current options.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# "true" = real web-grounded citations via OpenRouter's web-search plugin
# (~$0.02/request + model token cost) — the closest replication of ChatGPT's
# browsing mode, but not free. "false" = plain generation + simulated
# citations for UI demo purposes only.
OPENROUTER_ENABLE_WEB_SEARCH=false

# Origin allowed to call this API (Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated brand names to detect in AI answers and cited pages
# (case-insensitive substring match).
BRAND_KEYWORDS=Bajaj,Bajaj Almond Drops,Bajaj Consumer Care

# Upstash Redis (free tier, no card required) — console.upstash.com > Create
# Database > copy the "Redis Connection" URL (starts with rediss://). Used as
# both the Celery broker and result backend. Upstash's URL is rediss:// (TLS)
# — Celery's redis backend requires an explicit ssl_cert_reqs query param on
# rediss:// URLs or it refuses to start; append ?ssl_cert_reqs=required
# (lowercase — redis-py's URL parser only accepts none/optional/required).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# UTC hour the daily Celery Beat fetch schedule fires (0-23). Move to a
# weekly crontab in celery_beat_schedule.py once real paid engine APIs
# replace the free-tier test engines.
FETCH_SCHEDULE_HOUR_UTC=4
