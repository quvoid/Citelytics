# Supabase project settings — Project Settings > API in the Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey — free Gemini API key
GEMINI_API_KEY=
# Optional override; check https://ai.google.dev/gemini-api/docs/models for current Flash-tier models
GEMINI_MODEL=gemini-2.5-flash

# https://openrouter.ai/keys — free to create, no card required
OPENROUTER_API_KEY=
# Optional override; check https://openrouter.ai/models?order=pricing-low-to-high for current free models
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Set to "true" to enable OpenRouter's real web-grounded citations (costs
# OpenRouter credits, ~$0.02/request). Defaults to false (fully free, simulated citations).
OPENROUTER_ENABLE_WEB_SEARCH=false

# Origin allowed to call this API (Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated brand names to detect in AI answers and cited pages
# (case-insensitive substring match).
BRAND_KEYWORDS=Bajaj,Bajaj Almond Drops,Bajaj Consumer Care
